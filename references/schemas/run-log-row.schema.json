{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "references/schemas/run-log-row.schema.json",
 "title": "One run-log.jsonl row",
 "description": "The runner's record of one node attempt: what ran, at what model and effort, the claude -p result event's fields, and the gate's verdict. A code node carries null in the agent fields.",
 "type": "object",
 "additionalProperties": false,
 "required": ["node", "role", "model", "effort", "attempt", "start", "end", "usage", "modelUsage", "duration_ms", "duration_api_ms",
              "num_turns", "subtype", "permission_denials", "gate_exit", "gate_stderr"],
 "properties": {
  "node": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
  "role": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
  "model": {"type": ["string", "null"], "minLength": 1},
  "effort": {"enum": ["low", "medium", "high", "xhigh", "max", null]},
  "attempt": {"type": "integer", "minimum": 1},
  "start": {"$ref": "#/$defs/time"},
  "end": {"$ref": "#/$defs/time"},
  "usage": {"type": ["object", "null"], "description": "The result event's usage, as the CLI wrote it."},
  "modelUsage": {"type": ["object", "null"]},
  "duration_ms": {"type": ["integer", "null"], "minimum": 0},
  "duration_api_ms": {"type": ["integer", "null"], "minimum": 0},
  "num_turns": {"type": ["integer", "null"], "minimum": 0},
  "subtype": {"type": ["string", "null"], "description": "success, error_max_turns and the CLI's other result subtypes."},
  "permission_denials": {"type": ["array", "null"]},
  "gate_exit": {"type": ["integer", "null"], "description": "stage-check.py's exit; null when the node failed before its gate ran."},
  "gate_stderr": {"type": "string"}
 },
 "$defs": {
  "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}
 }
}

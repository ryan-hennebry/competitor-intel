        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|WebFetch|TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/run_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
